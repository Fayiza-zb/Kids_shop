{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build server",
      "type": "shell",
      "command": "gcc server.c -o server",
      "windows": { "command": "gcc server.c -o server.exe -lws2_32" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Run server",
      "type": "shell",
      "command": "./server",
      "windows": { "command": ".\\server.exe" },
      "dependsOn": "Build server",
      "problemMatcher": []
    }
  ]
}
